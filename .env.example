# PostgreSQL para Docker Compose
POSTGRES_DB=crm_mida
POSTGRES_USER=crm_mida
POSTGRES_PASSWORD=CAMBIAR_CONTRASENA_SEGURA
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=5173

# Usuario administrador inicial
CRM_ADMIN_EMAIL=admin@mida.mx
CRM_ADMIN_PASSWORD=CAMBIAR_CONTRASENA_INICIAL
CRM_ADMIN_FIRST_NAME=Administrador
CRM_ADMIN_LAST_NAME=MIDA

# Backend ASP.NET Core
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=crm_mida;Username=crm_mida;Password=CAMBIAR_CONTRASENA_SEGURA
Jwt__Issuer=crm-mida-api
Jwt__Audience=crm-mida-web
Jwt__Secret=CAMBIAR_POR_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
Jwt__ExpirationMinutes=60

# CONTPAQi Comercial Premium (solo lectura desde CRM MIDA)
CommercialPremium__ConnectionString=Server=SERVIDOR,PUERTO;Database=adMIDA_PRUEBAS;User Id=USUARIO;Password=CONTRASENA;TrustServerCertificate=True;Encrypt=False;
CommercialPremium__AllowedDatabase=adMIDA_PRUEBAS
CommercialPremium__QuoteConceptId=1
CommercialPremium__QuoteSeries=CZM
CommercialPremium__EnableWrites=false

# Documentos
Documents__StoragePath=/var/lib/crm-mida/documents

# Portal y PDF de cotizaciones
QuotePortal__PublicUrl=https://crm.example.com/public/quotes
QuoteDelivery__PublicApiUrl=https://api.example.com

# SMTP opcional
QuoteDelivery__Smtp__Host=
QuoteDelivery__Smtp__Port=587
QuoteDelivery__Smtp__EnableSsl=true
QuoteDelivery__Smtp__User=
QuoteDelivery__Smtp__Password=
QuoteDelivery__Smtp__From=

# Evolution API opcional
QuoteDelivery__Evolution__BaseUrl=
QuoteDelivery__Evolution__Instance=
QuoteDelivery__Evolution__ApiKey=

# Alertas de licencias
LicenseAlerts__Enabled=false
LicenseAlerts__TimeZone=America/Mexico_City
LicenseAlerts__Hour=8
LicenseAlerts__Days=90
LicenseAlerts__NotifyEmail=false
LicenseAlerts__NotifyWhatsApp=false

# Frontend Vite
VITE_API_URL=http://localhost:8080
